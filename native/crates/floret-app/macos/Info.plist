<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded in the `floret` binary (__TEXT,__info_plist, see build.rs) so
     macOS shows the microphone prompt for the unbundled executable, and
     copied into Floret.app by `./floret.sh install`, which adds the icon
     and version keys. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>app.floret.Floret</string>
	<key>CFBundleName</key>
	<string>Floret</string>
	<key>CFBundleExecutable</key>
	<string>floret</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Floret uses the microphone when a patch's AudioIn node is started.</string>
	<key>NSCameraUsageDescription</key>
	<string>Floret uses the camera for the Camera and Landmarks nodes in your patches. Video stays on this computer.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- .flora patches: Finder shows them as Floret documents and opens
	     them in Floret on double-click (the app handles the resulting
	     open-documents Apple Event, see the floret-open-files crate). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Floret Patch</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.floret.patch</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.floret.patch</string>
			<key>UTTypeDescription</key>
			<string>Floret Patch</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>flora</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
