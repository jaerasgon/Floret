    {
      "id": "cs_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -294
      },
      "params": {
        "text": "Colour spaces and generated palettes\n\nTop: the same red → blue blend in rgb (dull and dark in the middle), oklab (even) and oklch (round the hue wheel) — Lerp's space option.\nMiddle: a cosine palette (Palette, mode cosine).\nBottom: a tetradic harmony around a base colour whose hue turns with time.",
        "width": 480,
        "height": 230
      },
      "portValues": {
        "text": "Colour spaces and generated palettes\n\nTop: the same red → blue blend in rgb (dull and dark in the middle), oklab (even) and oklch (round the hue wheel) — Lerp's space option.\nMiddle: a cosine palette (Palette, mode cosine).\nBottom: a tetradic harmony around a base colour whose hue turns with time.",
        "width": 480,
        "height": 230
      }
    },
