  "nodes": [
    {
      "id": "cg_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -344
      },
      "params": {
        "text": "Key, then grade\n\nA 'green-screen shot' (petals on a green backdrop) goes through Effect · key: the green turns transparent, spill takes the green cast off the edges, and a gradient sky shows through. The whole picture is then graded: Levels sets black and white points, Curves pulls cool shadows and warm highlights (each colour pin is a point of the curve, per channel), and a 3D LUT from a .cube file (in the File node — Replace… to use your own) adds a faded film look at 80 %.",
        "width": 480,
        "height": 280
      },
      "portValues": {
        "text": "Key, then grade\n\nA 'green-screen shot' (petals on a green backdrop) goes through Effect · key: the green turns transparent, spill takes the green cast off the edges, and a gradient sky shows through. The whole picture is then graded: Levels sets black and white points, Curves pulls cool shadows and warm highlights (each colour pin is a point of the curve, per channel), and a 3D LUT from a .cube file (in the File node — Replace… to use your own) adds a faded film look at 80 %.",
        "width": 480,
        "height": 280
      }
    },
