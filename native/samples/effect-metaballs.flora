  "nodes": [
    {
      "id": "mb_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -314
      },
      "params": {
        "text": "Gooey metaballs from four Effects\n\nBlur (gaussian) softens the circles' edges so neighbours' coverage adds up; Threshold with `channel` alpha cuts that coverage at 0.5 — where blobs come close they melt together. Glow (coverage-based, unlike Bloom) adds a halo; an inner Shadow, offset up and left, shades the far edges for depth.\n\nTry the blur radius: bigger = gooier.",
        "width": 460,
        "height": 250
      },
      "portValues": {
        "text": "Gooey metaballs from four Effects\n\nBlur (gaussian) softens the circles' edges so neighbours' coverage adds up; Threshold with `channel` alpha cuts that coverage at 0.5 — where blobs come close they melt together. Glow (coverage-based, unlike Bloom) adds a halo; an inner Shadow, offset up and left, shades the far edges for depth.\n\nTry the blur radius: bigger = gooier.",
        "width": 460,
        "height": 250
      }
    },
