  "nodes": [
    {
      "id": "rn_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -314
      },
      "params": {
        "text": "Lens, motion and barrel\n\nCity lights: scattered dots through Effect · blur, kind lens — a disc kernel, so each light opens into a bokeh disc, `highlights` brightening them like a real lens. Rain: small dots falling (two copies, a screen apart, so it loops) through blur kind motion along the fall angle, which streaks them. Barrel bulges the whole frame like a wide lens.",
        "width": 460,
        "height": 250
      },
      "portValues": {
        "text": "Lens, motion and barrel\n\nCity lights: scattered dots through Effect · blur, kind lens — a disc kernel, so each light opens into a bokeh disc, `highlights` brightening them like a real lens. Rain: small dots falling (two copies, a screen apart, so it loops) through blur kind motion along the fall angle, which streaks them. Barrel bulges the whole frame like a wide lens.",
        "width": 460,
        "height": 250
      }
    },
