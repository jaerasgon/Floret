    {
      "id": "ws_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -274
      },
      "params": {
        "text": "Zoom and spin blur\n\nA starfield through two Effect · blur nodes: kind spin smears each star round the centre (`angle` radians of arc), kind zoom streaks it along the line from the centre (`amount` = how far towards it). An LFO pulses the zoom: cruising, then the jump. Levels (in white 0.35) brightens the faint streaks; the sharp stars go back on top.",
        "width": 420,
        "height": 210
      },
      "portValues": {
        "text": "Zoom and spin blur\n\nA starfield through two Effect · blur nodes: kind spin smears each star round the centre (`angle` radians of arc), kind zoom streaks it along the line from the centre (`amount` = how far towards it). An LFO pulses the zoom: cruising, then the jump. Levels (in white 0.35) brightens the faint streaks; the sharp stars go back on top.",
        "width": 420,
        "height": 210
      }
    },
