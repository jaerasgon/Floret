    "modifiedAt": "2026-10-09T00:00:00.000Z"
  },
  "nodes": [
    {
      "id": "fl_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -264
      },
      "params": {
        "text": "Flow lines\n\nContours' `flow` mode traces streamlines through a vector field — here its built-in `angle` field (Perlin noise turned into directions). Lines are spaced evenly (Jobard–Lefer): each new line seeds the next ones `spacing` to either side, and a line stops when it comes within half a spacing of another, so the page fills like a plotter drawing.\n\nTime turns every direction slowly (`turn`), so the lines re-trace as the field swings round. Try `field` curl, a smaller `spacing`, or wire your own `vectors`.",
        "width": 520,
        "height": 200
      },
      "portValues": {
        "text": "Flow lines\n\nContours' `flow` mode traces streamlines through a vector field — here its built-in `angle` field (Perlin noise turned into directions). Lines are spaced evenly (Jobard–Lefer): each new line seeds the next ones `spacing` to either side, and a line stops when it comes within half a spacing of another, so the page fills like a plotter drawing.\n\nTime turns every direction slowly (`turn`), so the lines re-trace as the field swings round. Try `field` curl, a smaller `spacing`, or wire your own `vectors`.",
        "width": 520,
        "height": 200
      }
    },
