  "nodes": [
    {
      "id": "ls_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -284
      },
      "params": {
        "text": "L-system plant\n\nThe L-System node rewrites `X` five times by its rules, then a turtle draws the string: F steps forward, + and - turn by `angle`, [ and ] branch.\n\n`jitter` bends every turn a little at random (fixed by `seed`); an LFO sways `angle` like wind.",
        "width": 420,
        "height": 220
      },
      "portValues": {
        "text": "L-system plant\n\nThe L-System node rewrites `X` five times by its rules, then a turtle draws the string: F steps forward, + and - turn by `angle`, [ and ] branch.\n\n`jitter` bends every turn a little at random (fixed by `seed`); an LFO sways `angle` like wind.",
        "width": 420,
        "height": 220
      }
    },
    {
      "id": "ls_lfo",
      "defType": "motion/lfo",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "shape": "sine",
        "rate": 0.15,
        "min": 22.5,
        "max": 27.5
      },
      "portValues": {
        "shape": "sine",
        "rate": 0.15,
        "min": 22.5,
        "max": 27.5
      }
    },
    {
      "id": "ls_stroke",
      "defType": "style/stroke",
      "position": {
