    {
      "id": "ls_plant",
      "defType": "geometry/lsystem",
      "position": {
        "x": 260,
        "y": 226
      },
      "params": {},
      "portValues": {
        "axiom": "X",
        "rules": "X=F+[[X]-X]-F[-FX]+X; F=FF",
        "iterations": 5,
        "step": 5.4,
        "fit": 0,
        "position": {
          "x": -105,
          "y": 245
        },
        "heading": -90,
        "jitter": 4,
        "seed": 7
      }
    },
