  "nodes": [
    {
      "id": "mo_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -264
      },
      "params": {
        "text": "Mondrian splits\n\nCells' `subdivide` mode cuts the square in two, then keeps cutting the parts — each with probability `chance`, down to `depth` levels, never thinner than `minSize`. `gap` leaves black lines between the rectangles, and each one takes a colour from the palette at random: white is listed four times, so it wins most often.\n\nChange `seed` for a new composition; turn on `quad` for a quadtree.",
        "width": 520,
        "height": 200
      },
      "portValues": {
        "text": "Mondrian splits\n\nCells' `subdivide` mode cuts the square in two, then keeps cutting the parts — each with probability `chance`, down to `depth` levels, never thinner than `minSize`. `gap` leaves black lines between the rectangles, and each one takes a colour from the palette at random: white is listed four times, so it wins most often.\n\nChange `seed` for a new composition; turn on `quad` for a quadtree.",
        "width": 520,
        "height": 200
      }
    },
