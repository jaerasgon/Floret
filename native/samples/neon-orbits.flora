  "nodes": [
    {
      "id": "no_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -284
      },
      "params": {
        "text": "Neon orbits\n\nThree ellipse outlines turn at different speeds over a faint grid. Effect in `glow` mode lights their coverage; with `blend` `add` the glow is light: it brightens the lines themselves and the grid under the halo, and where halos cross they add up. (`normal` lays the glow underneath and covers what's behind it.)",
        "width": 460,
        "height": 220
      },
      "portValues": {
        "text": "Neon orbits\n\nThree ellipse outlines turn at different speeds over a faint grid. Effect in `glow` mode lights their coverage; with `blend` `add` the glow is light: it brightens the lines themselves and the grid under the halo, and where halos cross they add up. (`normal` lays the glow underneath and covers what's behind it.)",
        "width": 460,
        "height": 220
      }
    },
