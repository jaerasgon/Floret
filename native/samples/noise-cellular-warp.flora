    {
      "id": "nz_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -274
      },
      "params": {
        "text": "Noise — one node, five kinds\n\nNoise samples the whole 64×64 grid at once (spreads in, spreads out). Cellular mode, feature F2-F1, draws the cell walls; warp bends them with a second noise field, and y drifting with time makes the field flow.\n\nTry mode perlin / simplex / value, feature F1, or warp 0.",
        "width": 460,
        "height": 210
      },
      "portValues": {
        "text": "Noise — one node, five kinds\n\nNoise samples the whole 64×64 grid at once (spreads in, spreads out). Cellular mode, feature F2-F1, draws the cell walls; warp bends them with a second noise field, and y drifting with time makes the field flow.\n\nTry mode perlin / simplex / value, feature F1, or warp 0.",
        "width": 460,
        "height": 210
      }
    },
