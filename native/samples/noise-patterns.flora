  "nodes": [
    {
      "id": "np_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -314
      },
      "params": {
        "text": "Pattern fields\n\nNoise's pattern modes are values at positions, like its noise modes, so `warp` bends them: stripes become marble, rings wood grain, checker op art. Each panel samples a 48×48 grid; the three panels then go through Effect · blur (smooths the cells), posterize (bands) and edges (`keep` 1: contour lines on top) — a topographic map.",
        "width": 460,
        "height": 250
      },
      "portValues": {
        "text": "Pattern fields\n\nNoise's pattern modes are values at positions, like its noise modes, so `warp` bends them: stripes become marble, rings wood grain, checker op art. Each panel samples a 48×48 grid; the three panels then go through Effect · blur (smooths the cells), posterize (bands) and edges (`keep` 1: contour lines on top) — a topographic map.",
        "width": 460,
        "height": 250
      }
    },
