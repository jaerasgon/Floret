    {
      "id": "pp_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -344
      },
      "params": {
        "text": "Polygon pinball\n\ncollider/from-layer accepts any shape layer. Here a draw/polygon octagon is wired into BOTH the renderer (so you can see it) AND the collider (so it deflects particles). The collider precomputes edge normals at compile and uses them for proper bounce — not a centroid approximation.",
        "width": 500,
        "height": 280
      },
      "portValues": {
        "text": "Polygon pinball\n\ncollider/from-layer accepts any shape layer. Here a draw/polygon octagon is wired into BOTH the renderer (so you can see it) AND the collider (so it deflects particles). The collider precomputes edge normals at compile and uses them for proper bounce — not a centroid approximation.",
        "width": 500,
        "height": 280
      }
    },
