    {
      "id": "ps_c",
      "defType": "meta/comment",
      "position": {
        "x": -756,
        "y": 0
      },
      "params": {
        "text": "Galactic spiral\n\nphysics/world.integrator is set to VERLET — two-pass integration that preserves long-running orbits much better than Euler. Vortex + central attractor produce stable spirals; trails (per-particle buffer colour, fadeOut) drag the colour through space.\n\nFlip the integrator to euler and watch the particles drift outward over time.",
        "width": 500,
        "height": 280
      },
      "portValues": {
        "text": "Galactic spiral\n\nphysics/world.integrator is set to VERLET — two-pass integration that preserves long-running orbits much better than Euler. Vortex + central attractor produce stable spirals; trails (per-particle buffer colour, fadeOut) drag the colour through space.\n\nFlip the integrator to euler and watch the particles drift outward over time.",
        "width": 500,
        "height": 280
      }
