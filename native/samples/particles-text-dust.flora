    {
      "id": "pt_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -324
      },
      "params": {
        "text": "Text dust\n\nparticles/from-layer (FromLayer, `fill`) samples points inside the glyph outlines of the wired text shape. The result is a Spread<vec2> of points INSIDE the glyphs — wire it into the Emitter's positions input and particles spawn from the letters themselves.\n\nTurbulence + slow upward drift turn the letters into smoke.",
        "width": 500,
        "height": 260
      },
      "portValues": {
        "text": "Text dust\n\nparticles/from-layer (FromLayer, `fill`) samples points inside the glyph outlines of the wired text shape. The result is a Spread<vec2> of points INSIDE the glyphs — wire it into the Emitter's positions input and particles spawn from the letters themselves.\n\nTurbulence + slow upward drift turn the letters into smoke.",
        "width": 500,
        "height": 260
      }
