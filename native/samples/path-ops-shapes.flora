  "nodes": [
    {
      "id": "ps_c",
      "defType": "meta/comment",
      "position": {
        "x": -534,
        "y": 0
      },
      "params": {
        "text": "Six Path Ops modes\n\nTop: round-corners (a triangle with 22 px arcs), thicken (an open spiral outlined as a filled shape with round caps), wave (a circle with whole waves round it, phase from Time's loop). Bottom: noise (a wobbling blob whose phase loops), twist (a square swirled round its centre) and explode (a hexagon's edges pushed apart and back). The deformers resample every `detail` px first.",
        "width": 470,
        "height": 250
      },
      "portValues": {
        "text": "Six Path Ops modes\n\nTop: round-corners (a triangle with 22 px arcs), thicken (an open spiral outlined as a filled shape with round caps), wave (a circle with whole waves round it, phase from Time's loop). Bottom: noise (a wobbling blob whose phase loops), twist (a square swirled round its centre) and explode (a hexagon's edges pushed apart and back). The deformers resample every `detail` px first.",
        "width": 470,
        "height": 250
      }
    },
