    {
      "id": "bo_hits",
      "defType": "math/expression",
      "position": {
        "x": 1001,
        "y": 659
      },
      "params": {
        "expr": "a > 0.5 && abs(c.x - q.x) <= 37.0 && abs(c.y - q.y) <= 17.0"
      }
    },
    {
      "id": "bo_broken",
      "defType": "math/statistics",
      "position": {
        "x": 1400,
        "y": 1071
      },
      "params": {
        "op": "sum"
      }
    },
    {
      "id": "bo_paddleHit",
      "defType": "math/expression",
      "position": {
        "x": 1769,
        "y": 1758
      },
      "params": {
        "expr": "v.y > 0 && q.y >= 222.0 && q.y <= 241.0 && abs(q.x - px) <= 59.0"
      }
    },
    {
      "id": "bo_lost",
      "defType": "math/expression",
      "position": {
        "x": 1001,
        "y": 1587
      },
      "params": {
        "expr": "!h && q.y > 300.0"
      }
    },
    {
      "id": "bo_standing",
      "defType": "math/statistics",
      "position": {
        "x": 1400,
        "y": 1197
      },
      "params": {
        "op": "sum"
      }
    },
    {
      "id": "bo_cleared",
      "defType": "math/expression",
      "position": {
        "x": 1769,
        "y": 1292
      },
      "params": {
        "expr": "n - b < 0.5"
      }
    },
    {
      "id": "bo_velNext",
      "defType": "math/expression",
      "position": {
        "x": 2153,
        "y": 1590
      },
      "params": {
        "expr": "h || lost || cl || s ? (launch ? normalize(vec2(0.45, -1)) * spd : vec2(0, 0)) : (ph ? normalize(vec2((q.x - px) / 52.0 * 0.95, -1)) * spd : vec2(q.x < -353.0 ? abs(v.x) : (q.x > 353.0 ? -abs(v.x) : v.x), q.y < -273.0 ? abs(v.y) : (hit > 0 ? -v.y : v.y)))"
      }
    },
    {
      "id": "bo_posNext",
      "defType": "math/expression",
      "position": {
        "x": 2153,
        "y": 768
      },
      "params": {
        "expr": "h || lost || cl || s ? vec2(px, 220.0) : q"
      }
    },
    {
      "id": "bo_heldNext",
      "defType": "math/expression",
      "position": {
        "x": 2153,
        "y": 1996
      },
      "params": {
        "expr": "s || lost || cl ? 1 : (h && !launch ? 1 : 0)"
      }
    },
    {
      "id": "bo_aliveNext",
      "defType": "math/expression",
      "position": {
        "x": 2153,
        "y": 0
      },
      "params": {
        "expr": "s || cl ? 1 : (a > 0.5 && !hit ? 1 : 0)"
      }
    },
    {
      "id": "bo_livesNext",
      "defType": "math/expression",
      "position": {
        "x": 1385,
        "y": 2236
      },
      "params": {
        "expr": "s ? 3 : l - lost"
      }
    },
    {
      "id": "bo_scoreNext",
      "defType": "math/expression",
      "position": {
        "x": 1769,
        "y": 1084
      },
      "params": {
        "expr": "s ? 0 : sc + b * 10 * lv"
      }
    },
