    {
      "id": "bo_turnsNote",
      "defType": "meta/comment",
      "position": {
        "x": 128,
        "y": 934
      },
      "params": {
        "text": "The game's turns. A click (Edge on the mouse button) starts a game when the demo is running or the game is over, and launches the ball while it sits on the paddle. The demo launches by itself. Reads give whether a game is on, whether the ball is held, and the lives and level: no lives left = game over, and each level makes the ball 40 px/s faster. Their Writes sit at the end of the flow (in Next turn).",
        "width": 320,
        "height": 180
      },
      "parentId": "bo_turns"
    },
    {
      "id": "bo_playingNext",
      "defType": "logic/logic",
      "position": {
        "x": 602,
        "y": 115
      },
      "params": {
        "op": "or"
      },
      "parentId": "bo_turns"
    },
    {
      "id": "bo_countsNote",
      "defType": "meta/comment",
      "position": {
        "x": 140,
        "y": 736
      },
      "params": {
        "text": "A new game resets lives to 3, score to 0 and level to 1. A lost ball costs a life, every broken brick scores 10 × the level, and a cleared wall goes up a level. The Writes keep the new counts for next frame's Reads (lives and level are read in Turns).",
        "width": 300,
        "height": 120
      },
      "parentId": "bo_counts"
    },
