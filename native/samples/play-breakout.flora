    {
      "id": "bo_turnsNote",
      "defType": "meta/comment",
      "position": {
        "x": 146,
        "y": 667
      },
      "params": {
        "text": "The game's turns. A click (Edge on the mouse button) starts a game when the demo is running or the game is over, and launches the ball while it sits on the paddle. The demo launches by itself. Losing the ball costs a life; clearing the wall goes up a level. State nodes keep lives, score, level, whether a game is on and whether the ball is held.",
        "width": 320,
        "height": 150
      },
      "parentId": "bo_turns"
    },
    {
      "id": "bo_playingNext",
      "defType": "logic/logic",
      "position": {
        "x": 461,
        "y": 503
      },
      "params": {
        "op": "or"
      },
      "parentId": "bo_turns"
    },
    {
      "id": "bo_countsNote",
      "defType": "meta/comment",
      "position": {
        "x": 131,
        "y": 1026
      },
      "params": {
        "text": "A new game resets lives to 3, score to 0 and level to 1. A lost ball costs a life, every broken brick scores 10 × the level, a cleared wall goes up a level, and each level makes the ball 40 px/s faster. No lives left = game over.",
        "width": 300,
        "height": 110
      },
      "parentId": "bo_counts"
    },
