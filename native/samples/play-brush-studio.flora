    {
      "id": "bs_penLogicNote",
      "defType": "meta/comment",
      "position": {
        "x": 140,
        "y": 905
      },
      "params": {
        "text": "The pen is the mouse once the paper has been touched, the Demo pen before. It is down while the button is held (or for the demo's first 7 s); a stroke is drawn when it was down last frame too, from where it was (a Write → Read pair) to where it is.",
        "width": 300,
        "height": 110
      },
      "parentId": "bs_penLogic"
    },
    {
      "id": "bs_strokeDrawNote",
      "defType": "meta/comment",
      "position": {
        "x": 151,
        "y": 1000
      },
      "params": {
        "text": "This frame's piece of stroke with each brush; Lookup picks the chosen one, Symmetry repeats it eight ways round the centre when mirroring, and nothing is drawn while the pen is up.",
        "width": 300,
        "height": 100
      },
      "parentId": "bs_strokeDraw"
    },
