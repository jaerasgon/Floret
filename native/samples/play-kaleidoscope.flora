    },
    {
      "id": "kt_beadCol",
      "defType": "math/expression",
      "position": {
        "x": 1474,
        "y": 425
      },
      "params": {
        "expr": "hsl(fract(0.13 * floor(t * 7) + 0.07 * sin(t)), 0.85, 0.55 + 0.15 * sin(t * 11))"
      }
    },
    {
      "id": "kt_beadSize",
