    {
      "id": "kt_beadsNote",
      "defType": "meta/comment",
      "position": {
        "x": 168,
        "y": 1231
      },
      "params": {
        "text": "A burst of 260 beads a second for the first 45 frames, then 24 a second where you press. Left alone they drop in on a slow Lissajous path. Colours step round the wheel seven times a second with a little drift; sizes come from a hash of the time.",
