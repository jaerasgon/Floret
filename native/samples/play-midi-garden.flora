      },
      "params": {
        "expr": "q + vec2(cos(i / 160 * tau + a), sin(i / 160 * tau + a)) * g * (22 + 60 * v * (0.5 + br)) * (0.25 + 0.75 * abs(cos(k * (i / 160 * tau) / 2)))"
