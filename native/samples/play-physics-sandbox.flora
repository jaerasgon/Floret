    {
      "id": "ps_slingNote",
      "defType": "meta/comment",
      "position": {
        "x": 138,
        "y": 1082
      },
      "params": {
        "text": "A press remembers where it started (the anchor). The pull is the anchor minus the mouse, × 3.2: the launch velocity. Letting go fires one ball there (rate 61/s for one frame). Every half second, while rain is on, a ball drops in at a random x along the top. The aim arc samples where a ball fired now would be, every 0.045 s.",
        "width": 320,
        "height": 140
      },
      "parentId": "ps_sling"
    },
