    {
      "id": "pm_curve",
      "defType": "math/expression",
      "position": {
        "x": 410,
        "y": 40
      },
      "params": {
        "expr": "(vec2((R * (1 - k * 0.11) - r) * cos(i / 1400 * L * tau + a) + d * cos((R * (1 - k * 0.11) - r) / r * i / 1400 * L * tau - a), (R * (1 - k * 0.11) - r) * sin(i / 1400 * L * tau + a) - d * sin((R * (1 - k * 0.11) - r) / r * i / 1400 * L * tau - a))) * (250 * (0.5 + z * 0.8) / (abs(R - r) + d + 1)) * (1 + w * 0.08 * sin(i / 23 + t * 2)) * (1 + sw * 0.45)"
      },
      "parentId": "pm_layerLoop"
    },
    {
      "id": "pm_angle",
      "defType": "math/expression",
      "position": {
        "x": 144,
        "y": 196
      },
      "params": {
        "expr": "ph + t * s * (1 + k * 0.3) + k * tw * 1.2"
      },
      "parentId": "pm_layerLoop"
    },
    {
      "id": "pm_lineCol",
      "defType": "math/expression",
      "position": {
        "x": 144,
        "y": 404
      },
      "params": {
        "expr": "hsl(fract(h + k * s), 0.85, 0.6, 0.85)"
      },
      "parentId": "pm_layerLoop"
    },
    {
      "id": "pm_lineStroke",
      "defType": "style/stroke",
      "position": {
