    {
      "id": "vo_editNote",
      "defType": "meta/comment",
      "position": {
        "x": 148,
        "y": 852
      },
      "params": {
        "text": "Every point's distance to the mouse; the smallest (Statistics min) and its index (Lookup index-of) are the nearest point. A press within 26 px grabs it until release (a State), and the grabbed point follows the mouse. Holding L moves every other point 12 % of the way to the middle of its cell (Scatter's relax mode as a target, then Lerp). A click on empty space appends a point, X removes the nearest (keeping three), R or Reset starts over.",
        "width": 330,
        "height": 170
      },
      "parentId": "vo_edit"
    },
