          "g": 1.0,
          "b": 1.0,
          "a": 1.0
        }
      }
    },
    {
      "id": "pc_link",
      "defType": "geometry/connect",
      "position": {
        "x": 539,
        "y": 0
      },
      "params": {
        "mode": "distance",
        "colorBy": "points"
      },
      "portValues": {
        "distance": 100,
        "maxLinks": 6,
        "fade": 0.9,
        "taper": 0.5,
        "colorBy": "points"
      }
    },
