    "modifiedAt": "2026-10-23T00:00:00.000Z"
  },
  "nodes": [
    {
      "id": "pr_doc",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -364
      },
      "params": {
        "text": "POSE RIBBONS\n\nSwitch the Camera on, step back so it can see you, and move. Your head, hands and feet each leave a long, glowing ribbon in a colour of their own. Wave, spin, dance: the ribbons are fat and bright where you are now and thin out behind you. Step out of the picture and they melt away. Your skeleton is only a faint whisper underneath.\n\nHow it works: the pose tracker finds your body. Ribbon memory remembers where five of its points have been for the last two seconds, and Ribbons draws a tapering line through each trail. The colours are added together like light, left to glow and fade.\n\nMake it yours: double-click Ribbons to change a ribbon's colour, or turn the glow up or down in the Effect.",
        "width": 600,
        "height": 300
      },
      "portValues": {
        "text": "POSE RIBBONS\n\nSwitch the Camera on, step back so it can see you, and move. Your head, hands and feet each leave a long, glowing ribbon in a colour of their own. Wave, spin, dance: the ribbons are fat and bright where you are now and thin out behind you. Step out of the picture and they melt away. Your skeleton is only a faint whisper underneath.\n\nHow it works: the pose tracker finds your body. Ribbon memory remembers where five of its points have been for the last two seconds, and Ribbons draws a tapering line through each trail. The colours are added together like light, left to glow and fade.\n\nMake it yours: double-click Ribbons to change a ribbon's colour, or turn the glow up or down in the Effect.",
        "width": 600,
        "height": 300
      }
    },
