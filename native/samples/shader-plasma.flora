        "min": 1,
        "max": 24
      }
    },
    {
      "id": "sh_shader",
      "defType": "gpu/shader",
      "position": {
        "x": -84,
        "y": 0
      },
      "params": {
        "source": "uniform float scale;\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n  uv *= scale;\n  float t = iTime * 0.5;\n  float v = sin(uv.x + t)\n          + sin(uv.y + t)\n          + sin(uv.x + uv.y + t)\n          + sin(length(uv) * 2.0 - t);\n  vec3 col = 0.5 + 0.5 * cos(vec3(0.0, 2.0, 4.0) + v + t);\n  fragColor = vec4(col, 1.0);\n}",
        "feedback": false
      },
      "portValues": {
        "source": "uniform float scale;\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n  uv *= scale;\n  float t = iTime * 0.5;\n  float v = sin(uv.x + t)\n          + sin(uv.y + t)\n          + sin(uv.x + uv.y + t)\n          + sin(length(uv) * 2.0 - t);\n  vec3 col = 0.5 + 0.5 * cos(vec3(0.0, 2.0, 4.0) + v + t);\n  fragColor = vec4(col, 1.0);\n}",
        "feedback": false
      }
    },
    {
      "id": "sh_renderer",
      "defType": "render/renderer",
      "position": {
        "x": 503.99999999999994,
        "y": 0
      },
      "params": {
