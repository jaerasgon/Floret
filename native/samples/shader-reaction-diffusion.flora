        "bufferC": "// Gray-Scott, one step. Buffers A-D each run this, A reading D's last\n// frame and B-D the buffer before: four steps a frame. iChannel0 = the\n// field so far. Buffers are 8 bits per\n// channel, too coarse for the chemistry's small steps, so each chemical\n// is kept to 16 bits in two channels: A in .rg, B in .ba.\nvec2 pack2(float v) {\n  v = clamp(v, 0.0, 1.0) * 255.0;\n  return vec2(floor(v) / 255.0, fract(v));\n}\nfloat unpack2(vec2 v) { return v.x + v.y / 255.0; }\nvec2 field(vec2 uv) {\n  vec4 t = texture(iChannel0, uv);\n  return vec2(unpack2(t.rg), unpack2(t.ba));\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec2 px = 1.0 / iResolution.xy;\n  // Seed (A=1, a few B blobs) on the first frame, or wherever the field\n  // is still empty (the buffers start out all zero).\n  if (iFrame < 1 || texture(iChannel0, uv) == vec4(0.0)) {\n    float b = step(0.985, fract(sin(dot(floor(uv * 24.0), vec2(12.9898, 78.233))) * 43758.5453));\n    fragColor = vec4(pack2(1.0), pack2(b));\n    return;\n  }\n  // Laplacian (Karl Sims' 3x3 kernel: 0.2 edges, 0.05 corners, -1 centre;\n  // a plain 4-neighbour one is unstable at these rates and grows crosses).\n  vec2 c = field(uv);\n  vec2 lap = 0.2 * (field(uv + vec2(px.x, 0.0)) + field(uv - vec2(px.x, 0.0))\n                  + field(uv + vec2(0.0, px.y)) + field(uv - vec2(0.0, px.y)))\n           + 0.05 * (field(uv + px) + field(uv - px)\n                   + field(uv + vec2(px.x, -px.y)) + field(uv + vec2(-px.x, px.y)))\n           - c;\n  float A = c.x, B = c.y;\n  float reaction = A * B * B;\n  float feed = 0.055, kill = 0.062;\n  float A2 = A + (1.0 * lap.x - reaction + feed * (1.0 - A));\n  float B2 = B + (0.5 * lap.y + reaction - (kill + feed) * B);\n  fragColor = vec4(pack2(A2), pack2(B2));\n}",
