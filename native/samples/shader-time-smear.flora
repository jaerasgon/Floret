    {
      "id": "ts_shader",
      "defType": "gpu/shader",
      "position": {
        "x": 1274,
        "y": 35
      },
      "params": {
        "source": "// Time smear: each band of rows shows the input as it was a\n// different number of frames ago, the delay rolling down the picture\n// like a wave, with blocky glitches now and then. `history` on the\n// node keeps the last 48 frames; iHistoryFrame(ago, uv) reads one.\nuniform float bands;\nuniform float glitch;\nuniform vec4 background;\n\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  float band = floor(fragCoord.y / max(bands, 1.0));\n  // A wave of delay down the rows.\n  float lag = 0.5 + 0.5 * sin(band * 0.21 - iTime * 2.3);\n  // Now and then a block jumps further back.\n  vec2 cell = floor(fragCoord / 32.0);\n  float beat = floor(iTime * 4.0);\n  if (hash(cell + beat) < glitch) lag = hash(cell - beat);\n  int ago = int(lag * float(iHistoryCount - 1));\n  vec4 c = iHistoryFrame(ago, uv);\n  // Premultiplied over the background.\n  fragColor = vec4(c.rgb + background.rgb * (1.0 - c.a), 1.0);\n}",
        "feedback": false,
        "history": 48
      },
      "portValues": {
        "bands": 6,
        "glitch": 0.06,
        "background": {
          "r": 0.07058823529411765,
          "g": 0.050980392156862744,
          "b": 0.12156862745098039,
          "a": 1.0
        }
      }
    },
