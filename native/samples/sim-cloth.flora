    {
      "id": "cl_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -284
      },
      "params": {
        "text": "Cloth\n\nA Verlet spring mesh: 30 × 20 points joined by springs, hanging from its two top corners. Every step the points keep their speed, fall and catch the wind, then the springs pull them back toward their rest length.\n\nPress and drag on the canvas to grab the cloth. Pull hard and springs stretched past `tear` × their length snap (the lower slider). Springs colour by how far they're stretched. The upper slider blows wind in gusts.",
        "width": 560,
        "height": 220
      },
      "portValues": {
        "text": "Cloth\n\nA Verlet spring mesh: 30 × 20 points joined by springs, hanging from its two top corners. Every step the points keep their speed, fall and catch the wind, then the springs pull them back toward their rest length.\n\nPress and drag on the canvas to grab the cloth. Pull hard and springs stretched past `tear` × their length snap (the lower slider). Springs colour by how far they're stretched. The upper slider blows wind in gusts.",
        "width": 560,
        "height": 220
      }
    },
