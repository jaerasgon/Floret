  "nodes": [
    {
      "id": "dl_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -290
      },
      "params": {
        "text": "DLA coral\n\nDiffusion-limited aggregation: random walkers wander in from outside and stick where they first touch the cluster, so the tips catch the most and it branches like coral, frost or lightning.\n\nEach line joins a particle to the one it stuck to; `colors` runs from the first particle to the newest. Lower `stickiness` lets walkers slip further in, for a denser growth (the slider). Click the Bang to grow it again.",
        "width": 560,
        "height": 220
      },
      "portValues": {
        "text": "DLA coral\n\nDiffusion-limited aggregation: random walkers wander in from outside and stick where they first touch the cluster, so the tips catch the most and it branches like coral, frost or lightning.\n\nEach line joins a particle to the one it stuck to; `colors` runs from the first particle to the newest. Lower `stickiness` lets walkers slip further in, for a denser growth (the slider). Click the Bang to grow it again.",
        "width": 560,
        "height": 220
      }
    },
