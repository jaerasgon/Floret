      },
      "params": {}
    },
    {
      "id": "sq_hovered",
      "defType": "math/expression",
      "position": {
        "x": 659,
        "y": 542
      },
      "params": {
        "expr": "abs(m.x) < 288.0 && m.y >= -174.0 && m.y < 114.0 ? floor((m.y - (-174.0)) / 36) * 16 + floor((m.x + 288.0) / 36) : -1"
      }
    },
