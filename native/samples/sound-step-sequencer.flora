      "defType": "math/expression",
      "position": {
        "x": 2025,
        "y": 186
      },
      "params": {
        "expr": "clr || (hit && key == 0) ? 0 : (rnd || (hit && key == 1) ? (fract(sin(index * 12.9898 + t * 78.233) * 43758.5453) > 0.84 ? 1 : 0) : (p && index == h ? v : c))"
