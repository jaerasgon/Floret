  "nodes": [
    {
      "id": "clk_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -324
      },
      "params": {
        "text": "Living clock\n\nDriven by the real time: the Clock node reads the computer's clock every frame (time of day, date, weekday, how far through the year). From the outside in: 60 second ticks, the minutes and hours as arcs, and a spiral of the year's 365 days — past days in their month's colour, today pulsing with the seconds. The sky behind follows the hour, the Moon shows its real phase (days since a known new moon ÷ 29.53), and the date is spelled out from lists of day and month names (Lookup).\n\n• Slider into the Clock's `offset`: time travel, ± 12 hours (try evening).\n• Toggle: 24-hour or 12-hour digits.",
        "width": 560,
        "height": 260
      },
      "portValues": {
        "text": "Living clock\n\nDriven by the real time: the Clock node reads the computer's clock every frame (time of day, date, weekday, how far through the year). From the outside in: 60 second ticks, the minutes and hours as arcs, and a spiral of the year's 365 days — past days in their month's colour, today pulsing with the seconds. The sky behind follows the hour, the Moon shows its real phase (days since a known new moon ÷ 29.53), and the date is spelled out from lists of day and month names (Lookup).\n\n• Slider into the Clock's `offset`: time travel, ± 12 hours (try evening).\n• Toggle: 24-hour or 12-hour digits.",
        "width": 560,
        "height": 260
      }
    },
