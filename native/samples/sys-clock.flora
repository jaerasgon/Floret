        "y": 204
      },
      "params": {
        "expr": "i < d ? hsl(fract(0.58 + i / 365), 0.6, 0.6) : (i == d ? rgb(1, 1, 1) : rgb(1, 1, 1, 0.13))"
      },
      "parentId": "clk_days",
      "portValues": {}
    },
