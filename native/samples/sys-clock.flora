    {
      "id": "clk_tickInner",
      "defType": "math/expression",
      "position": {
        "x": 140,
        "y": 40
      },
      "params": {
        "expr": "vec2(cos(i / 60 * tau - pi / 2), sin(i / 60 * tau - pi / 2)) * (i % 5 == 0 ? 232 : 240)"
      },
