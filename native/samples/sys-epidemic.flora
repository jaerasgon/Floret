      "defType": "math/expression",
      "position": {
        "x": 3189,
        "y": 724
      },
      "params": {
        "expr": "s == 0 ? ((distance(p, q) < r && fract(sin(index * 12.9898 + frame * 78.233) * 43758.5453) < 2.5 * h) || (pr && distance(p, m) < 26) ? 1 : 0) : (s == 1 ? (k > rec ? 2 : 1) : (fract(sin(index * 12.9898 + frame * 78.233) * 43758.5453) < w * h ? 0 : 2))"
      },
      "portValues": {}
