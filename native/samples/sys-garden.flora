    },
    {
      "id": "gdn_winter",
      "defType": "math/expression",
      "position": {
        "x": 980,
        "y": 1843
      },
      "params": {
        "expr": "clamp(1 - abs(s - 3.6) * 2.2, 0, 1) + clamp(1 - s * 3, 0, 1) * 0.5"
      },
      "portValues": {}
    },
    {
