    {
      "id": "tw_elevation",
      "defType": "math/expression",
      "position": {
        "x": 352,
        "y": 586
      },
      "params": {
        "expr": "0.5 + (noise(q.x * 0.005 + 3.7, q.y * 0.005 + 1.3) - 0.5) * 1.6 + (noise(q.x * 0.013, q.y * 0.013 + 7.1) - 0.5) * 0.45 + 0.2 - length(q) / 420"
      },
      "portValues": {}
    },
