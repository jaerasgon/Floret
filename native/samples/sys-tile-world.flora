      "defType": "math/expression",
      "position": {
        "x": 669,
        "y": 380
      },
      "params": {
        "expr": "ev < s - 0.08 ? rgb(0.13, 0.33, 0.55) : (ev < s ? rgb(0.25, 0.52, 0.72) : (ev < s + 0.04 ? rgb(0.89, 0.83, 0.6) : (ev < s + 0.24 ? rgb(0.47, 0.71, 0.33) : (ev < s + 0.42 ? rgb(0.2, 0.47, 0.25) : (ev < s + 0.58 ? rgb(0.52, 0.5, 0.47) : rgb(0.95, 0.96, 0.98))))))"
      },
