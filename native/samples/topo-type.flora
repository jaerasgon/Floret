  "nodes": [
    {
      "id": "tt_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -314
      },
      "params": {
        "text": "Topo type\n\nContours' `shape` mode measures the distance from the outlines of a wired shape — here the glyphs of a word — and draws rings at `threshold`, `threshold + step`, … units out (negative goes inside). The outer rings go underneath, so filled rings stack into the bands of a contour map.\n\nWire a Palette into `colors`: the levels take its colours from the first (the word) to the last (the outermost ring). The thin dark stroke keeps the bands apart.",
        "width": 480,
        "height": 250
      },
      "portValues": {
        "text": "Topo type\n\nContours' `shape` mode measures the distance from the outlines of a wired shape — here the glyphs of a word — and draws rings at `threshold`, `threshold + step`, … units out (negative goes inside). The outer rings go underneath, so filled rings stack into the bands of a contour map.\n\nWire a Palette into `colors`: the levels take its colours from the first (the word) to the last (the outermost ring). The thin dark stroke keeps the bands apart.",
        "width": 480,
        "height": 250
      }
    },
