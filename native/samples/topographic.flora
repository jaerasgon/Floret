{
  "kind": "floret.patch",
  "version": 2,
  "appVersion": "0.0.1",
  "meta": {
    "name": "Topographic",
    "createdAt": "2026-10-09T00:00:00.000Z",
    "modifiedAt": "2026-10-09T00:00:00.000Z"
  },
  "nodes": [
    {
      "id": "top_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -284
      },
      "params": {
        "text": "Topographic\n\nNoise sampled on a 120 × 84 grid (a little bigger than the canvas, so the edge lines fall outside) is a height field; Contours (`field` mode) traces it at 14 levels, like the lines of a map. The noise drifts with time, so the hills slowly shift.\n\nTry Contours' `points` mode (metaballs from a point spread) or `image` mode (outlines of a picture's brightness).",
        "width": 470,
        "height": 220
      },
      "portValues": {
        "text": "Topographic\n\nNoise sampled on a 120 × 84 grid (a little bigger than the canvas, so the edge lines fall outside) is a height field; Contours (`field` mode) traces it at 14 levels, like the lines of a map. The noise drifts with time, so the hills slowly shift.\n\nTry Contours' `points` mode (metaballs from a point spread) or `image` mode (outlines of a picture's brightness).",
        "width": 470,
        "height": 220
      }
    },
    {
      "id": "tp_grid",
      "defType": "spread/grid",
      "position": {
        "x": 0,
        "y": 38
      },
      "params": {
        "cols": 120,
        "rows": 84,
        "w": 760,
        "h": 520
      },
      "portValues": {
        "cols": 120,
        "rows": 84,
        "w": 760,
        "h": 520
      }
    },
    {
      "id": "tp_warp",
      "defType": "math/expression",
      "position": {
        "x": 223,
        "y": 0
      },
      "params": {
        "expr": "vec2(p.x, p.y) * 0.0045 + vec2(0.0, t * 0.04)"
      },
      "portValues": {}
    },
    {
      "id": "tp_noise",
      "defType": "noise/noise",
      "position": {
        "x": 487,
        "y": 16
      },
      "params": {
        "mode": "simplex"
      },
      "portValues": {
        "octaves": 3,
        "falloff": 0.5
      }
    },
    {
      "id": "tp_line",
      "defType": "style/stroke",
      "position": {
        "x": 503,
        "y": 318
      },
      "params": {
        "color": {
          "r": 0.788235294117647,
          "g": 0.7254901960784313,
          "b": 0.5764705882352941,
          "a": 1.0
        },
        "width": 1.4,
        "align": "center"
      },
      "portValues": {
        "color": {
          "r": 0.788235294117647,
          "g": 0.7254901960784313,
          "b": 0.5764705882352941,
          "a": 1.0
        },
        "width": 1.4,
        "align": "center"
      }
    },
    {
      "id": "tp_nofill",
      "defType": "style/no-fill",
      "position": {
        "x": 265,
        "y": 384
      },
      "params": {}
    },
    {
      "id": "tp_c",
      "defType": "geometry/contours",
      "position": {
        "x": 760,
        "y": 68
      },
      "params": {
        "mode": "field"
      },
      "portValues": {
        "cols": 120,
        "size": {
          "x": 760,
          "y": 520
        },
        "threshold": -0.65,
        "levels": 14,
        "step": 0.1
      }
    },
    {
      "id": "tp_r",
      "defType": "render/renderer",
      "position": {
        "x": 1007,
        "y": 68
      },
      "params": {
        "width": 720,
        "height": 480,
        "background": {
          "r": 0.10588235294117647,
          "g": 0.16470588235294117,
          "b": 0.1843137254901961,
          "a": 1.0
        }
      },
