          "a": 1.0
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e_tp_grid_tp_warp_p",
      "source": "tp_grid",
      "target": "tp_warp",
      "sourceHandle": "out-positions",
      "targetHandle": "in-p"
    },
    {
      "id": "e_tp_warp_tp_noise_pos",
      "source": "tp_warp",
      "target": "tp_noise",
      "sourceHandle": "out-value",
      "targetHandle": "in-pos"
    },
    {
      "id": "e_tp_noise_tp_c_values",
