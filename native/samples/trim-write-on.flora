  "nodes": [
    {
      "id": "tri_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -294
      },
      "params": {
        "text": "Write-on lettering\n\nGlyphs lays out the word; Trim Path (`sequence`) reveals its outlines one after another as `end` runs from 0 to 1, so the letters are written in order. The pen nib sits on `heads`.\n\nTry `each` (every outline at once), or animate `offset` with a short `end` for a travelling dash.",
        "width": 460,
        "height": 230
      },
      "portValues": {
        "text": "Write-on lettering\n\nGlyphs lays out the word; Trim Path (`sequence`) reveals its outlines one after another as `end` runs from 0 to 1, so the letters are written in order. The pen nib sits on `heads`.\n\nTry `each` (every outline at once), or animate `offset` with a short `end` for a travelling dash.",
        "width": 460,
        "height": 230
      }
    },
