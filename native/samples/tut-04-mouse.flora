      "params": {
        "text": "Reading user input\n\n`input/mouse` exposes the cursor position inside the preview canvas (centred at 0,0). Wire `x` and `y` into a shape and it follows the mouse.\n\nHover the preview to drag the circle around.",
        "width": 360,
        "height": 200
      },
