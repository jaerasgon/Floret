      "id": "t09_c",
      "defType": "meta/comment",
      "position": {
        "x": -560,
        "y": 0
      },
      "params": {
        "text": "State = memory across frames\n\n`state/value` carries a value from one frame to the next.\n• `current` is what last frame stored.\n• Wire something into `next` and that becomes `current` on the very next frame.\n\nHere we add 1 every frame and use it to rotate the hue.",
        "width": 380,
        "height": 240
      },
      "portValues": {
        "text": "State = memory across frames\n\n`state/value` carries a value from one frame to the next.\n• `current` is what last frame stored.\n• Wire something into `next` and that becomes `current` on the very next frame.\n\nHere we add 1 every frame and use it to rotate the hue.",
        "width": 380,
        "height": 240
      }
    },
