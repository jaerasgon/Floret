      "params": {
        "text": "Remapping ranges\n\n`math/map` converts a value from one range to another. Example: mouseX is in [-200, 200] but a hue needs [0, 360].\n\nMove the mouse left/right — the ellipse changes hue across the rainbow.",
        "width": 380,
        "height": 220
      },
      "portValues": {
