    {
      "id": "t19_c",
      "defType": "meta/comment",
      "position": {
        "x": -616,
        "y": 0
      },
      "params": {
        "text": "Conditional execution\n\n`region/if` only runs its body when `condition` is true — its outputs become empty when false.\n\nHere `sin(time) > 0` toggles the condition, so the red rectangle blinks on and off. Swap the time source for a mouse, slider, or key to drive it yourself.",
        "width": 420,
        "height": 240
      },
      "portValues": {
        "text": "Conditional execution\n\n`region/if` only runs its body when `condition` is true — its outputs become empty when false.\n\nHere `sin(time) > 0` toggles the condition, so the red rectangle blinks on and off. Swap the time source for a mouse, slider, or key to drive it yourself.",
        "width": 420,
        "height": 240
      }
    },
