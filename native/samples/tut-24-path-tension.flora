    {
      "id": "t24_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -284
      },
      "params": {
        "text": "Curved paths\n\n`draw/path`'s `tension` input smooths the polyline through your points. tension = 0 → straight segments; tension → 0.5 gives Catmull-Rom curves.\n\nTime drives the tension so the wave breathes between sharp and smooth.",
        "width": 380,
        "height": 220
      },
      "portValues": {
        "text": "Curved paths\n\n`draw/path`'s `tension` input smooths the polyline through your points. tension = 0 → straight segments; tension → 0.5 gives Catmull-Rom curves.\n\nTime drives the tension so the wave breathes between sharp and smooth.",
        "width": 380,
        "height": 220
      }
    },
