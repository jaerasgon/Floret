    {
      "id": "t27_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -304
      },
      "params": {
        "text": "Image sampling\n\n`image/sample-spread` reads N colours from an image at N points. Combine with a grid generator and you get a \"downsample\" pipeline — perfect for posterising or pixel-art looks.\n\nA noisy gradient rasterised, then sampled at 24×24 grid centres.",
        "width": 440,
        "height": 240
      },
      "portValues": {
        "text": "Image sampling\n\n`image/sample-spread` reads N colours from an image at N points. Combine with a grid generator and you get a \"downsample\" pipeline — perfect for posterising or pixel-art looks.\n\nA noisy gradient rasterised, then sampled at 24×24 grid centres.",
        "width": 440,
        "height": 240
      }
