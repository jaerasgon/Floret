  "nodes": [
    {
      "id": "t27_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -304
      },
      "params": {
        "text": "Image sampling\n\n`image/sample-spread` reads N colours from an image at N points, measured from its centre like positions on the canvas. Combine with a grid generator and you get a \"downsample\" pipeline — perfect for posterising or pixel-art looks.\n\nA diagonal gradient (a triadic palette whose hue drifts with time) is rasterised at 256×256, then sampled at 24×24 grid points and redrawn as squares.",
        "width": 440,
        "height": 240
      },
      "portValues": {
        "text": "Image sampling\n\n`image/sample-spread` reads N colours from an image at N points, measured from its centre like positions on the canvas. Combine with a grid generator and you get a \"downsample\" pipeline — perfect for posterising or pixel-art looks.\n\nA diagonal gradient (a triadic palette whose hue drifts with time) is rasterised at 256×256, then sampled at 24×24 grid points and redrawn as squares.",
        "width": 440,
        "height": 240
      }
    },
