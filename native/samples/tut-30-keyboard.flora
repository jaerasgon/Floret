  "nodes": [
    {
      "id": "t30_c",
      "defType": "meta/comment",
      "position": {
        "x": -644,
        "y": 0
      },
      "params": {
        "text": "Branching on keyboard input\n\n`input/keyboard.key` outputs the last key pressed (e.g. \"a\", \"ArrowLeft\"). `logic/eq` checks equality against a constant string. Wire the result into a `region/if` and you get key-driven branches.\n\nPress R for red rect, B for blue ellipse — others draw nothing.",
        "width": 440,
        "height": 240
      },
      "portValues": {
        "text": "Branching on keyboard input\n\n`input/keyboard.key` outputs the last key pressed (e.g. \"a\", \"ArrowLeft\"). `logic/eq` checks equality against a constant string. Wire the result into a `region/if` and you get key-driven branches.\n\nPress R for red rect, B for blue ellipse — others draw nothing.",
        "width": 440,
        "height": 240
      }
    },
