        "x": 0,
        "y": -264
      },
      "params": {
        "text": "Loading images\n\n`io/image-url` fetches an image asynchronously. Once it lands, the `image` output carries a canvas you can draw, sample, or filter.\n\nDouble-click the node to change the URL. Picsum returns a fresh photo per seed.",
        "width": 420,
        "height": 200
      },
      "portValues": {
        "text": "Loading images\n\n`io/image-url` fetches an image asynchronously. Once it lands, the `image` output carries a canvas you can draw, sample, or filter.\n\nDouble-click the node to change the URL. Picsum returns a fresh photo per seed.",
        "width": 420,
        "height": 200
      }
    },
