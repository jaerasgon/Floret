      "params": {
        "text": "Image adjustments\n\nImage filter nodes are pipelines: image in, image out. Chain them like styles.\n\nload → adjust (brightness/contrast/saturation/hue) → draw. Tweak the inputs to see the change immediately.",
        "width": 420,
        "height": 200
      },
      "portValues": {
