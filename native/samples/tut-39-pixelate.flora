      "params": {
        "text": "Retro pixel look\n\n`image/pixelate` downsamples then upsamples — chunky blocks.\n\nA slider drives the block size. Big values give Atari, small values keep most detail.",
        "width": 420,
        "height": 200
      },
      "portValues": {
