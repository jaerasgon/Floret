      "id": "t40_c",
      "defType": "meta/comment",
      "position": {
        "x": -644,
        "y": 0
      },
      "params": {
        "text": "Pixel sorting (datamosh)\n\n`pixel/sort` reorders runs of pixels along rows or columns by brightness/saturation. The \"lo/hi\" inputs mask which pixels get sorted, leaving the rest in place.\n\nA classic glitch-art look.",
        "width": 440,
        "height": 220
      },
      "portValues": {
        "text": "Pixel sorting (datamosh)\n\n`pixel/sort` reorders runs of pixels along rows or columns by brightness/saturation. The \"lo/hi\" inputs mask which pixels get sorted, leaving the rest in place.\n\nA classic glitch-art look.",
        "width": 440,
        "height": 220
      }
    },
