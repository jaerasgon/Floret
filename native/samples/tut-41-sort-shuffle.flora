    {
      "id": "t41_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -284
      },
      "params": {
        "text": "Reordering spreads\n\n`ShuffleSpread` (RandomizeSpread) permutes a spread deterministically by its seed; `SortSpread` arranges numbers ascending (or descending).\n\nHere 0…29 is shuffled, then sorted again, and drawn as a bar chart: a neat staircase. Wire the shuffle straight into the ForEach (skip Sort) to see the shuffled order.",
        "width": 440,
        "height": 220
      },
      "portValues": {
        "text": "Reordering spreads\n\n`ShuffleSpread` (RandomizeSpread) permutes a spread deterministically by its seed; `SortSpread` arranges numbers ascending (or descending).\n\nHere 0…29 is shuffled, then sorted again, and drawn as a bar chart: a neat staircase. Wire the shuffle straight into the ForEach (skip Sort) to see the shuffled order.",
        "width": 440,
        "height": 220
      }
    },
