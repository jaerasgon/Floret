      "position": {
        "x": 0,
        "y": -304
      },
      "params": {
        "text": "Game of Life\n\n`spread/gol-step` advances a 2-D boolean grid by one Conway tick.\n\nHere the grid is read from state, stepped, written back. Plus a starter pattern in the upper-left so frame 0 has something to chew on. Watch the colony evolve.",
        "width": 440,
        "height": 240
      },
      "portValues": {
