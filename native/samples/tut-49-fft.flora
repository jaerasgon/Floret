    {
      "id": "t49_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -304
      },
      "params": {
        "text": "FFT spectrum bars\n\n`sound/fft` analyses a live audio signal and outputs a `spectrum` spread (one number per frequency bin, 0..1). Wrap it in a ForEach with an index and you get a bar-chart visualiser.\n\nMic → 128 bins → 128 rectangles. Grant microphone permission.",
        "width": 440,
        "height": 240
      },
      "portValues": {
        "text": "FFT spectrum bars\n\n`sound/fft` analyses a live audio signal and outputs a `spectrum` spread (one number per frequency bin, 0..1). Wrap it in a ForEach with an index and you get a bar-chart visualiser.\n\nMic → 128 bins → 128 rectangles. Grant microphone permission.",
        "width": 440,
        "height": 240
      }
    },
