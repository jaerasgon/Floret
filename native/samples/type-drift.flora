  "nodes": [
    {
      "id": "tdr_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -304
      },
      "params": {
        "text": "Noise drift\n\nThe passage sits as a monospace grid. A slow Perlin “mask” (smoothstep threshold) picks drifting CLUSTERS; inside them a second noise field shoves the letters around and tints them, while the rest stays still and readable. The clusters wander over time.",
        "width": 500,
        "height": 240
      },
      "portValues": {
        "text": "Noise drift\n\nThe passage sits as a monospace grid. A slow Perlin “mask” (smoothstep threshold) picks drifting CLUSTERS; inside them a second noise field shoves the letters around and tints them, while the rest stays still and readable. The clusters wander over time.",
        "width": 500,
        "height": 240
      }
    },
    {
      "id": "tdr_str",
      "defType": "value/string",
      "position": {
        "x": 0,
        "y": 82
      },
      "params": {
        "value": "It was the best of times,       it was the worst of times,      it was the age of wisdom,       it was the age of foolishness,  it was the epoch of belief,     it was the epoch of incredulity,it was the season of Light,     it was the season of Darkness.  "
      },
      "portValues": {
        "value": "It was the best of times,       it was the worst of times,      it was the age of wisdom,       it was the age of foolishness,  it was the epoch of belief,     it was the epoch of incredulity,it was the season of Light,     it was the season of Darkness.  "
      }
    },
