    {
      "id": "gp_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -294
      },
      "params": {
        "text": "Particles from glyph outlines\n\ntext/outline samples points every few units along the letterforms’ contours. They seed a particle emitter, drift on turbulence and fade. The font’s weight breathes with time (style/font-variations), so the outlines — and the particles born on them — thicken and thin.",
        "width": 460,
        "height": 230
      },
      "portValues": {
        "text": "Particles from glyph outlines\n\ntext/outline samples points every few units along the letterforms’ contours. They seed a particle emitter, drift on turbulence and fade. The font’s weight breathes with time (style/font-variations), so the outlines — and the particles born on them — thicken and thin.",
        "width": 460,
        "height": 230
      }
    },
