    {
      "id": "trn_c",
      "defType": "meta/comment",
      "position": {
        "x": -756,
        "y": 0
      },
      "params": {
        "text": "Type rain\n\nA 18 × 22 grid where each column scrolls vertically at a unique noise-seeded speed. y = (rowIdx · ROW_H + time · speed[col]) mod CANVAS_H − CANVAS_H/2. Characters appear to fall like Matrix code.",
        "width": 500,
        "height": 240
      },
      "portValues": {
        "text": "Type rain\n\nA 18 × 22 grid where each column scrolls vertically at a unique noise-seeded speed. y = (rowIdx · ROW_H + time · speed[col]) mod CANVAS_H − CANVAS_H/2. Characters appear to fall like Matrix code.",
        "width": 500,
        "height": 240
      }
    },
