  "nodes": [
    {
      "id": "rv_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -304
      },
      "params": {
        "text": "The Raven\n\nA passage laid out as a serif grid. Each letter's opacity is its own slow Perlin walk — noise(i, time) — so letters fade in and out independently in black & white, and the dimmer a letter gets, the more it blurs.",
        "width": 500,
        "height": 240
      },
      "portValues": {
        "text": "The Raven\n\nA passage laid out as a serif grid. Each letter's opacity is its own slow Perlin walk — noise(i, time) — so letters fade in and out independently in black & white, and the dimmer a letter gets, the more it blurs.",
        "width": 500,
        "height": 240
      }
    },
    {
      "id": "rv_split",
      "defType": "string/split",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "text": "Once upon a midnight dreary,     while I pondered, weak and weary,over many a quaint and curious   volume of forgotten lore —       while I nodded, nearly napping,  suddenly there came a tapping,   "
      },
      "portValues": {
        "text": "Once upon a midnight dreary,     while I pondered, weak and weary,over many a quaint and curious   volume of forgotten lore —       while I nodded, nearly napping,  suddenly there came a tapping,   "
