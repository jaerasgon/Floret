  "nodes": [
    {
      "id": "rv_c",
      "defType": "meta/comment",
      "position": {
        "x": -784,
        "y": 0
      },
      "params": {
        "text": "The Raven\n\nA passage laid out as a serif grid. Each letter's opacity is its own slow Perlin walk — noise(i, time) — so letters fade in and out independently in black & white, and the dimmer a letter gets, the more it blurs.",
        "width": 500,
        "height": 240
      },
      "portValues": {
        "text": "The Raven\n\nA passage laid out as a serif grid. Each letter's opacity is its own slow Perlin walk — noise(i, time) — so letters fade in and out independently in black & white, and the dimmer a letter gets, the more it blurs.",
        "width": 500,
        "height": 240
      }
    },
    {
      "id": "rv_str",
      "defType": "value/string",
      "position": {
        "x": -784,
        "y": 550
      },
      "params": {
        "value": "Once upon a midnight dreary,     while I pondered, weak and weary,over many a quaint and curious   volume of forgotten lore —       while I nodded, nearly napping,  suddenly there came a tapping,   "
      },
      "portValues": {
        "value": "Once upon a midnight dreary,     while I pondered, weak and weary,over many a quaint and curious   volume of forgotten lore —       while I nodded, nearly napping,  suddenly there came a tapping,   "
      }
    },
