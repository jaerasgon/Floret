{
  "kind": "floret.patch",
  "version": 2,
  "appVersion": "0.0.1",
  "meta": {
    "name": "Video Pixelate",
    "createdAt": "2026-10-01T00:00:00.000Z",
    "modifiedAt": "2026-10-01T00:00:00.000Z"
  },
  "nodes": [
    {
      "id": "vp_doc",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -354
      },
      "params": {
        "text": "VIDEO PIXELATE\n\nA video file played as an image and run through an image effect.\n\nVideo File plays a short embedded clip on a loop. Click Replace… on it to play your own MP4 / MOV (H.264 everywhere; on macOS also HEVC and ProRes). play, loop and speed set the playback; wire a 0..1 number into scrub to scrub through it instead.\n\nThe frames go through Pixelate (the slider sets the block size) into Draw Image, like any other image.",
        "width": 400,
        "height": 290
      },
      "portValues": {
        "text": "VIDEO PIXELATE\n\nA video file played as an image and run through an image effect.\n\nVideo File plays a short embedded clip on a loop. Click Replace… on it to play your own MP4 / MOV (H.264 everywhere; on macOS also HEVC and ProRes). play, loop and speed set the playback; wire a 0..1 number into scrub to scrub through it instead.\n\nThe frames go through Pixelate (the slider sets the block size) into Draw Image, like any other image.",
        "width": 400,
        "height": 290
      }
    },
    {
      "id": "vp_video",
      "defType": "video/file",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "url": "data:video/mp4;base64,"
      },
      "portValues": {}
    },
    {
      "id": "vp_size",
      "defType": "io/slider",
      "position": {
        "x": 0,
        "y": 260
      },
      "params": {
        "value": 6,
        "min": 1,
        "max": 24
      },
      "portValues": {
        "value": 6,
        "min": 1,
        "max": 24
      }
    },
    {
      "id": "vp_pix",
      "defType": "image/pixelate",
      "position": {
        "x": 279,
        "y": 144
      },
      "params": {}
    },
    {
      "id": "vp_draw",
      "defType": "draw/image",
      "position": {
        "x": 473,
        "y": 144
      },
      "params": {
        "w": 640,
        "h": 360
      },
      "portValues": {
        "w": 640,
        "h": 360
      }
    },
    {
      "id": "vp_renderer",
      "defType": "render/renderer",
      "position": {
        "x": 668,
        "y": 144
      },
      "params": {
        "width": 640,
        "height": 360
      },
      "portValues": {
        "width": 640,
        "height": 360
      }
    }
  ],
  "edges": [
    {
      "id": "e_1",
      "source": "vp_video",
      "target": "vp_pix",
      "sourceHandle": "out-image",
      "targetHandle": "in-image"
    },
    {
      "id": "e_2",
      "source": "vp_size",
      "target": "vp_pix",
      "sourceHandle": "out-number",
      "targetHandle": "in-size"
    },
    {
      "id": "e_3",
      "source": "vp_pix",
      "target": "vp_draw",
      "sourceHandle": "out-image",
      "targetHandle": "in-image"
    },
