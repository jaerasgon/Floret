{
  "kind": "floret.patch",
  "version": 4,
  "appVersion": "0.0.1",
  "meta": {
    "name": "Voronoi Mosaic",
    "createdAt": "2026-10-03T00:00:00.000Z",
    "modifiedAt": "2026-10-03T00:00:00.000Z"
  },
  "nodes": [
    {
      "id": "vm_c",
      "defType": "meta/comment",
      "position": {
        "x": 0,
        "y": -294
      },
      "params": {
        "text": "Voronoi mosaic\n\nScatter lays points at least `distance` apart (Poisson disc). Cells turns them into Voronoi cells inside the canvas, `gap` apart, each filled from the palette. Path Ops smooths every cell's corners (Chaikin).\n\nChange the seed for a new mosaic; switch Cells to `delaunay` for triangles.",
        "width": 420,
        "height": 230
      },
      "portValues": {
        "text": "Voronoi mosaic\n\nScatter lays points at least `distance` apart (Poisson disc). Cells turns them into Voronoi cells inside the canvas, `gap` apart, each filled from the palette. Path Ops smooths every cell's corners (Chaikin).\n\nChange the seed for a new mosaic; switch Cells to `delaunay` for triangles.",
        "width": 420,
        "height": 230
      }
    },
    {
      "id": "vm_scatter",
      "defType": "geometry/scatter",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "mode": "poisson"
      },
      "portValues": {
        "size": {
          "x": 520,
          "y": 520
        },
        "distance": 34,
        "seed": 3
      }
    },
    {
      "id": "vm_pal",
      "defType": "color/palette",
      "position": {
        "x": 16,
        "y": 236
      },
      "params": {
        "stopCount": 5,
        "c0": "#264653",
        "c1": "#2a9d8f",
        "c2": "#e9c46a",
        "c3": "#f4a261",
        "c4": "#e76f51"
      },
      "portValues": {
        "stopCount": 5
      }
    },
    {
      "id": "vm_cells",
      "defType": "geometry/cells",
      "position": {
        "x": 317,
        "y": 118
      },
      "params": {
        "mode": "voronoi"
      },
      "portValues": {
        "size": {
          "x": 520,
          "y": 520
        },
        "gap": 7
      }
    },
    {
      "id": "vm_smooth",
      "defType": "geometry/path-ops",
      "position": {
        "x": 576,
        "y": 74
      },
      "params": {
        "mode": "smooth"
      },
      "portValues": {
        "iterations": 3
      }
    },
    {
      "id": "vm_renderer",
      "defType": "render/renderer",
      "position": {
        "x": 865,
        "y": 74
      },
